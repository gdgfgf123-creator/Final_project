MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1424838555}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c216f11bfca3184281dd808fb726074, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OpeningDialogue
  dialoguePanel: {fileID: 1460556261}
  characterNameText: {fileID: 1390369472}
  nextButton: {fileID: 315466643}
  skipButton: {fileID: 2118189022}
  playerImage: {fileID: 1869784360}
  characterImage: {fileID: 2025208406}
  playerPortrait: {fileID: -8448783385617640126, guid: c21f82e3a14e9da4c851b802abc1e66d, type: 3}
  inactiveBrightness: 0.5
  dialogueBodyText: {fileID: 1815218134}
  lines:
  - characterName: Narrator
    text: "\u0E22\u0E32\u0E21\u0E23\u0E32\u0E15\u0E23\u0E35 \u0E41\u0E2A\u0E07\u0E08\u0E31\u0E19\u0E17\u0E23\u0E32\u0E2A\u0E35\u0E02\u0E32\u0E27\u0E19\u0E27\u0E25\n\u0E2A\u0E48\u0E2D\u0E07\u0E1B\u0E23\u0E30\u0E01\u0E32\u0E22\u0E40\u0E08\u0E34\u0E14\u0E08\u0E49\u0E32\u0E44\u0E1B\u0E17\u0E31\u0E48\u0E27\u0E2D\u0E32\u0E13\u0E32\u0E1A\u0E23\u0E34\u0E40\u0E27\u0E13"
    showPlayer: 0
    showCharacter: 0
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: "\u0E1C\u0E34\u0E14\u0E01\u0E31\u0E1A\u0E01\u0E25\u0E34\u0E48\u0E19\u0E02\u0E2D\u0E07\u0E0B\u0E32\u0E01\u0E28\u0E1E\u0E17\u0E35\u0E48\u0E25\u0E2D\u0E22\u0E1F\u0E38\u0E49\u0E07\u0E44\u0E1B\u0E43\u0E19\u0E2D\u0E32\u0E01\u0E32\u0E28\n\u0E17\u0E33\u0E40\u0E2D\u0E32\u0E44\u0E21\u0E48\u0E19\u0E48\u0E32\u0E2D\u0E20\u0E34\u0E23\u0E21\u0E22\u0E4C\u0E40\u0E2A\u0E35\u0E22\u0E19\u0E35\u0E48\u0E01\u0E23\u0E30\u0E44\u0E23"
    showPlayer: 0
    showCharacter: 0
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: "\u0E2A\u0E16\u0E32\u0E19\u0E17\u0E35\u0E48\u0E41\u0E2B\u0E48\u0E07\u0E19\u0E35\u0E49\u0E04\u0E37\u0E2D
      \u0E21\u0E2B\u0E32\u0E2A\u0E38\u0E2A\u0E32\u0E19\n\u0E40\u0E1B\u0E47\u0E19\u0E2A\u0E16\u0E32\u0E19\u0E17\u0E35\u0E48\u0E2A\u0E38\u0E14\u0E17\u0E49\u0E32\u0E22\u0E17\u0E35\u0E48\u0E04\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E08\u0E30\u0E44\u0E14\u0E49\u0E2B\u0E25\u0E31\u0E1A\u0E43\u0E2B\u0E25"
    showPlayer: 0
    showCharacter: 0
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: "\u0E01\u0E48\u0E2D\u0E19\u0E17\u0E35\u0E48\u0E1E\u0E27\u0E01\u0E40\u0E02\u0E32\u0E08\u0E30\u0E15\u0E37\u0E48\u0E19\u0E02\u0E36\u0E49\u0E19\u0E2D\u0E35\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07\n\u0E01\u0E25\u0E32\u0E22\u0E40\u0E1B\u0E47\u0E19\u0E20\u0E39\u0E15\u0E1C\u0E35\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E2D\u0E32\u0E28\u0E31\u0E22\u0E43\u0E19\u0E41\u0E14\u0E19\u0E04\u0E19\u0E15\u0E32\u0E22\u0E44\u0E1B\u0E15\u0E25\u0E2D\u0E14\u0E01\u0E32\u0E25"
    showPlayer: 0
    showCharacter: 0
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: "\u0E20\u0E39\u0E15\u0E1C\u0E35\u0E19\u0E31\u0E49\u0E19\u0E21\u0E35\u0E21\u0E32\u0E01\u0E2B\u0E19\u0E49\u0E32\u0E2B\u0E25\u0E32\u0E22\u0E15\u0E32\n\u0E40\u0E0A\u0E48\u0E19
      \u0E27\u0E34\u0E0D\u0E0D\u0E32\u0E13 \u0E42\u0E04\u0E23\u0E07\u0E01\u0E23\u0E30\u0E14\u0E39\u0E01
      \u0E0B\u0E2D\u0E21\u0E1A\u0E35\u0E49\n\u0E41\u0E21\u0E49\u0E01\u0E23\u0E30\u0E17\u0E31\u0E48\u0E07\u0E41\u0E27\u0E21\u0E44\u0E1E\u0E23\u0E4C\u0E22\u0E31\u0E07\u0E21\u0E35\u0E40\u0E25\u0E22\u0E19\u0E30"
    showPlayer: 0
    showCharacter: 0
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: "\u0E1E\u0E27\u0E01\u0E40\u0E02\u0E32\u0E2A\u0E48\u0E27\u0E19\u0E43\u0E2B\u0E0D\u0E48\u0E21\u0E31\u0E01\u0E44\u0E21\u0E48\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E08\u0E14\u0E08\u0E33\n\u0E04\u0E27\u0E32\u0E21\u0E17\u0E23\u0E07\u0E08\u0E33\u0E43\u0E19\u0E0A\u0E48\u0E27\u0E07\u0E17\u0E35\u0E48\u0E40\u0E1B\u0E47\u0E19\u0E21\u0E19\u0E38\u0E29\u0E22\u0E4C\u0E44\u0E14\u0E49\u0E40\u0E25\u0E22"
    showPlayer: 0
    showCharacter: 0
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: "\u0E21\u0E31\u0E01\u0E40\u0E01\u0E34\u0E14\u0E08\u0E32\u0E01\u0E1B\u0E13\u0E34\u0E18\u0E32\u0E19\u0E2D\u0E31\u0E19\u0E41\u0E23\u0E07\u0E01\u0E25\u0E49\u0E32\n\u0E44\u0E21\u0E48\u0E01\u0E47\u0E40\u0E1B\u0E47\u0E19\u0E01\u0E32\u0E23\u0E15\u0E32\u0E22\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E17\u0E38\u0E01\u0E02\u0E4C\u0E17\u0E23\u0E21\u0E32\u0E19\n\u0E08\u0E19\u0E08\u0E14\u0E08\u0E33\u0E44\u0E14\u0E49\u0E02\u0E36\u0E49\u0E19\u0E43\u0E08"
    showPlayer: 0
    showCharacter: 0
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: "\u0E0A\u0E31\u0E01\u0E08\u0E30\u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E2A\u0E35\u0E22\u0E40\u0E27\u0E25\u0E32\u0E41\u0E25\u0E49\u0E27\u0E2A\u0E34\n\u0E16\u0E49\u0E32\u0E40\u0E0A\u0E48\u0E19\u0E19\u0E31\u0E49\u0E19\u0E40\u0E23\u0E32\u0E21\u0E32\u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E23\u0E32\u0E27\n\u0E02\u0E2D\u0E07\u0E15\u0E31\u0E27\u0E40\u0E2D\u0E01\u0E40\u0E23\u0E32\u0E01\u0E31\u0E19\u0E14\u0E35\u0E01\u0E27\u0E48\u0E32"
    showPlayer: 0
    showCharacter: 0
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: .
    showPlayer: 0
    showCharacter: 0
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: '.

      ...'
    showPlayer: 0
    showCharacter: 0
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: '.

      ...

      .....'
    showPlayer: 0
    showCharacter: 0
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: '...

      .....

      .......'
    showPlayer: 0
    showCharacter: 0
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E09\u0E31\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E43\u0E04\u0E23\u0E01\u0E31\u0E19\u0E19\u0E30?"
    showPlayer: 1
    showCharacter: 0
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E04\u0E27\u0E32\u0E21\u0E04\u0E34\u0E14\u0E17\u0E35\u0E48\u0E27\u0E19\u0E40\u0E27\u0E35\u0E22\u0E19\u0E40\u0E02\u0E49\u0E32\u0E21\u0E32\u0E43\u0E19\u0E2B\u0E31\u0E27\u0E40\u0E2A\u0E21\u0E2D\n\u0E15\u0E31\u0E49\u0E07\u0E41\u0E15\u0E48\u0E25\u0E37\u0E21\u0E15\u0E32\u0E02\u0E36\u0E49\u0E19"
    showPlayer: 1
    showCharacter: 0
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E40\u0E2B\u0E25\u0E48\u0E32\u0E23\u0E38\u0E48\u0E19\u0E1E\u0E35\u0E48\u0E0B\u0E2D\u0E21\u0E1A\u0E35\u0E49\u0E15\u0E48\u0E32\u0E07\u0E1A\u0E2D\u0E01\u0E01\u0E31\u0E19\u0E27\u0E48\u0E32\n\u0E09\u0E31\u0E19\u0E14\u0E39\u0E2D\u0E32\u0E22\u0E38\u0E19\u0E49\u0E2D\u0E22"
    showPlayer: 1
    showCharacter: 0
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E09\u0E31\u0E19\u0E23\u0E39\u0E49\u0E2A\u0E36\u0E01\u0E27\u0E48\u0E32\u0E15\u0E19\u0E40\u0E2D\u0E07\n\u0E01\u0E47\u0E04\u0E07\u0E44\u0E21\u0E48\u0E15\u0E48\u0E32\u0E07\u0E08\u0E32\u0E01\u0E1E\u0E27\u0E01\u0E40\u0E02\u0E32\u0E21\u0E32\u0E01\u0E2B\u0E23\u0E2D\u0E01"
    showPlayer: 1
    showCharacter: 0
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E41\u0E15\u0E48\u0E1E\u0E2D\u0E16\u0E36\u0E07\u0E04\u0E23\u0E31\u0E49\u0E07\u0E41\u0E23\u0E01\u0E17\u0E35\u0E48\u0E09\u0E31\u0E19\u0E2A\u0E48\u0E2D\u0E07\u0E01\u0E23\u0E30\u0E08\u0E01\n\u0E01\u0E47\u0E15\u0E01\u0E43\u0E08\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E1A\u0E2D\u0E01\u0E44\u0E21\u0E48\u0E16\u0E39\u0E01"
    showPlayer: 1
    showCharacter: 0
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E41\u0E04\u0E48\u0E2D\u0E32\u0E22\u0E38\u0E19\u0E49\u0E2D\u0E22\u0E41\u0E25\u0E49\u0E27!\n\u0E19\u0E35\u0E48\u0E21\u0E31\u0E19\u0E40\u0E14\u0E47\u0E01\u0E41\u0E25\u0E49\u0E27\u0E40\u0E1F\u0E49\u0E22!!"
    showPlayer: 1
    showCharacter: 0
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E04\u0E27\u0E32\u0E21\u0E2B\u0E07\u0E38\u0E14\u0E2B\u0E07\u0E34\u0E14\u0E44\u0E14\u0E49\u0E01\u0E25\u0E37\u0E19\u0E01\u0E34\u0E19\u0E04\u0E27\u0E32\u0E21\u0E23\u0E39\u0E49\u0E2A\u0E36\u0E01\n\u0E02\u0E2D\u0E07\u0E09\u0E31\u0E19\u0E08\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E14\u0E1E\u0E25\u0E48\u0E32\u0E19"
    showPlayer: 1
    showCharacter: 0
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E09\u0E31\u0E19\u0E08\u0E33\u0E44\u0E14\u0E49\u0E27\u0E48\u0E32\u0E43\u0E0A\u0E49\u0E40\u0E27\u0E25\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E2A\u0E31\u0E1B\u0E14\u0E32\u0E2B\u0E4C\n\u0E01\u0E27\u0E48\u0E32\u0E15\u0E19\u0E40\u0E2D\u0E07\u0E08\u0E30\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E22\u0E2D\u0E21\u0E23\u0E31\u0E1A\u0E21\u0E31\u0E19\u0E44\u0E14\u0E49"
    showPlayer: 1
    showCharacter: 0
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Gary
    text: "\u0E2B\u0E19\u0E38\u0E48\u0E21\u0E19\u0E49\u0E2D\u0E22\u0E2D\u0E22\u0E39\u0E48\u0E23\u0E36\u0E40\u0E1B\u0E25\u0E48\u0E32~"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "(\u0E04\u0E19\u0E40\u0E02\u0E32\u0E08\u0E30\u0E2B\u0E25\u0E31\u0E1A\u0E08\u0E30\u0E19\u0E2D\u0E19\n\u0E2D\u0E22\u0E48\u0E32\u0E21\u0E32\u0E01\u0E27\u0E19\u0E08\u0E30\u0E44\u0E14\u0E49\u0E44\u0E2B\u0E21\u0E40\u0E19\u0E35\u0E48\u0E22...)"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Gary
    text: "\u0E14\u0E39\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E08\u0E30\u0E2D\u0E22\u0E39\u0E48\u0E2A\u0E34\u0E19\u0E30\n\u0E09\u0E31\u0E19\u0E2D\u0E22\u0E32\u0E01\u0E1E\u0E32\u0E04\u0E19\u0E21\u0E32\u0E41\u0E19\u0E30\u0E19\u0E33\u0E43\u0E2B\u0E49\u0E19\u0E32\u0E22\u0E23\u0E39\u0E49\u0E08\u0E31\u0E01\u0E0B\u0E30\u0E2B\u0E19\u0E48\u0E2D\u0E22"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "(\u0E44\u0E21\u0E48\u0E2D\u0E22\u0E32\u0E01\u0E23\u0E39\u0E49\u0E08\u0E31\u0E01\u0E40\u0E25\u0E22\u0E2A\u0E31\u0E01\u0E01\u0E23\u0E30\u0E15\u0E34\u0E4A\u0E14)"
