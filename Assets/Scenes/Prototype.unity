    - characterName: Zom
      text: "\u0E43\u0E08\u0E40\u0E22\u0E47\u0E19\u0E01\u0E48\u0E2D\u0E19\u0E2A\u0E34\u0E04\u0E23\u0E31\u0E1A!"
      showPlayer: 1
      showCharacter: 1
      isPlayerSpeaking: 1
      characterPortrait: {fileID: 0}
    - characterName: '{BOSS}'
      text: "\u0E21\u0E32\u0E2A\u0E19\u0E38\u0E01\u0E14\u0E49\u0E27\u0E22\u0E01\u0E31\u0E19\u0E2B\u0E19\u0E48\u0E2D\u0E22\u0E44\u0E2B\u0E21?"
