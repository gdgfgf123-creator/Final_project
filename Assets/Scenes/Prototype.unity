    characterPortrait: {fileID: 0}
  - characterName: Vampire
    text: "\u0E42\u0E2D\u0E4A\u0E30 \u0E14\u0E39\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E08\u0E30\u0E16\u0E36\u0E07\u0E04\u0E34\u0E27\u0E1C\u0E21\u0E41\u0E25\u0E49\u0E27\n\u0E02\u0E2D\u0E1C\u0E48\u0E32\u0E19\u0E17\u0E32\u0E07\u0E44\u0E1B\u0E19\u0E30\u0E04\u0E23\u0E31\u0E1A"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: "\u0E41\u0E15\u0E48\u0E16\u0E36\u0E07\u0E01\u0E23\u0E30\u0E19\u0E31\u0E49\u0E19\u0E01\u0E47\u0E22\u0E31\u0E07\u0E21\u0E35\u0E1E\u0E27\u0E01\u0E17\u0E35\u0E48\u0E08\u0E33\u0E44\u0E14\u0E49\u0E2D\u0E22\u0E39\u0E48\u0E40\u0E0A\u0E48\u0E19\u0E01\u0E31\u0E19
      \u0E21\u0E31\u0E01\u0E40\u0E01\u0E34\u0E14\u0E08\u0E32\u0E01\u0E1B\u0E19\u0E34\u0E17\u0E32\u0E19\u0E2D\u0E31\u0E19\u0E41\u0E23\u0E07\u0E01\u0E25\u0E49\u0E32\u0E44\u0E21\u0E48\u0E01\u0E47\u0E40\u0E1B\u0E47\u0E19\u0E01\u0E32\u0E23\u0E15\u0E32\u0E22\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E17\u0E38\u0E01\u0E02\u0E4C\u0E17\u0E23\u0E21\u0E32\u0E13\u0E08\u0E19\u0E08\u0E14\u0E08\u0E33\u0E44\u0E14\u0E49\u0E02\u0E36\u0E49\u0E19\u0E43\u0E08"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: "\u0E41\u0E27\u0E21\u0E44\u0E1E\u0E23\u0E4C\u0E40\u0E14\u0E34\u0E19\u0E40\u0E02\u0E49\u0E32\u0E44\u0E1B\u0E43\u0E19\u0E07\u0E32\u0E19\n\u0E1C\u0E48\u0E32\u0E19\u0E40\u0E08\u0E49\u0E32\u0E2B\u0E19\u0E49\u0E32\u0E17\u0E35\u0E48\u0E23\u0E31\u0E01\u0E29\u0E32\u0E04\u0E27\u0E32\u0E21\u0E1B\u0E25\u0E2D\u0E14\u0E20\u0E31\u0E22\n\u0E15\u0E32\u0E21\u0E2B\u0E25\u0E31\u0E07\u0E44\u0E1B\u0E14\u0E49\u0E27\u0E22\u0E42\u0E04\u0E23\u0E07\u0E01\u0E23\u0E30\u0E14\u0E39\u0E01\u0E17\u0E31\u0E49\u0E07\u0E2A\u0E2D\u0E07"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E2A\u0E07\u0E2A\u0E31\u0E22\u0E1C\u0E21\u0E04\u0E07\u0E2B\u0E21\u0E14\u0E2B\u0E27\u0E31\u0E07\u0E41\u0E25\u0E49\u0E27\n\u0E02\u0E19\u0E32\u0E14\u0E04\u0E33\u0E40\u0E0A\u0E34\u0E0D\u0E40\u0E02\u0E49\u0E32\u0E23\u0E48\u0E27\u0E21\u0E07\u0E32\u0E19\n\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E04\u0E19\u0E2D\u0E37\u0E48\u0E19\u0E40\u0E02\u0E32"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E2A\u0E34 \u0E1E\u0E2D\u0E21\u0E32\u0E04\u0E34\u0E14\u0E14\u0E39\u0E41\u0E25\u0E49\u0E27\n\u0E17\u0E35\u0E48\u0E41\u0E01\u0E23\u0E23\u0E35\u0E48\u0E1A\u0E2D\u0E01\u0E27\u0E48\u0E32\u0E44\u0E1B\u0E40\u0E14\u0E15\n\u0E2D\u0E22\u0E48\u0E32\u0E1A\u0E2D\u0E01\u0E19\u0E30\u0E27\u0E48\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E20\u0E32\u0E22\u0E43\u0E19\u0E07\u0E32\u0E19\u0E19\u0E48\u0E30"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E44\u0E2B\u0E07\u0E09\u0E31\u0E19\u0E16\u0E36\u0E07\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E04\u0E33\u0E40\u0E0A\u0E34\u0E0D\n\u0E41\u0E15\u0E48\u0E44\u0E2D\u0E49\u0E0B\u0E31\u0E07\u0E01\u0E30\u0E1A\u0E4A\u0E27\u0E22\u0E19\u0E31\u0E48\u0E19\u0E21\u0E31\u0E19\u0E44\u0E14\u0E49\u0E40\u0E02\u0E49\u0E32\u0E1F\u0E30!!!"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: "\u0E2B\u0E22\u0E14\u0E1D\u0E19\u0E44\u0E14\u0E49\u0E23\u0E48\u0E27\u0E07\u0E2B\u0E25\u0E48\u0E19\u0E08\u0E32\u0E01\u0E17\u0E49\u0E2D\u0E07\u0E1F\u0E49\u0E32\n\u0E01\u0E23\u0E30\u0E17\u0E1A\u0E17\u0E35\u0E48\u0E43\u0E1A\u0E2B\u0E19\u0E49\u0E32\u0E02\u0E2D\u0E07\u0E0B\u0E2D\u0E21"
    showPlayer: 0
    showCharacter: 1
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E40\u0E2D\u0E4A\u0E30 \u0E1D\u0E19\u0E15\u0E01\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E19\u0E31\u0E49\u0E19\u0E40\u0E2B\u0E23\u0E2D?"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E09\u0E31\u0E19\u0E40\u0E07\u0E22\u0E2B\u0E19\u0E49\u0E32\u0E02\u0E36\u0E49\u0E19\u0E44\u0E1B\u0E21\u0E2D\u0E07\u0E1A\u0E19\u0E17\u0E49\u0E2D\u0E07\u0E1F\u0E49\u0E32\n\u0E16\u0E36\u0E07\u0E08\u0E30\u0E21\u0E35\u0E40\u0E21\u0E06\u0E1B\u0E01\u0E04\u0E25\u0E38\u0E21\u0E40\u0E1B\u0E47\u0E19\u0E2B\u0E22\u0E48\u0E2D\u0E21
      \u0E46 \u0E1A\u0E49\u0E32\u0E07"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E41\u0E15\u0E48\u0E01\u0E47\u0E44\u0E21\u0E48\u0E21\u0E35\u0E27\u0E35\u0E48\u0E41\u0E27\u0E27\u0E17\u0E35\u0E48\u0E1D\u0E19\u0E08\u0E30\u0E40\u0E23\u0E34\u0E48\u0E21\u0E15\u0E01\n\u0E40\u0E25\u0E22\u0E41\u0E21\u0E49\u0E41\u0E15\u0E48\u0E19\u0E49\u0E2D\u0E22"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E02\u0E13\u0E30\u0E14\u0E27\u0E07\u0E15\u0E32\u0E19\u0E35\u0E49\u0E01\u0E33\u0E25\u0E31\u0E07\u0E01\u0E27\u0E32\u0E14\u0E14\u0E39\u0E27\u0E48\u0E32\n\u0E1D\u0E19\u0E21\u0E32\u0E08\u0E32\u0E01\u0E44\u0E2B\u0E19"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E01\u0E47\u0E44\u0E14\u0E49\u0E44\u0E1B\u0E2A\u0E1A\u0E15\u0E32\u0E01\u0E31\u0E1A\u0E2B\u0E0D\u0E34\u0E07\u0E2A\u0E32\u0E27\n\u0E1A\u0E19\u0E23\u0E30\u0E40\u0E1A\u0E35\u0E22\u0E07\u0E40\u0E2A\u0E35\u0E22\u0E41\u0E25\u0E49\u0E27"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E40\u0E18\u0E2D\u0E21\u0E35\u0E1C\u0E21\u0E27\u0E39\u0E1F\u0E04\u0E31\u0E17\u0E2A\u0E35\u0E1F\u0E49\u0E32\u0E14\u0E2D\u0E01\u0E40\u0E2D\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E4C\n\u0E17\u0E35\u0E48\u0E15\u0E31\u0E14\u0E25\u0E07\u0E15\u0E31\u0E27\u0E01\u0E31\u0E1A\u0E2A\u0E35\u0E04\u0E23\u0E35\u0E21\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E2A\u0E27\u0E22\u0E07\u0E32\u0E21"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E41\u0E15\u0E48\u0E17\u0E33\u0E44\u0E21\u0E01\u0E31\u0E19\u0E19\u0E30\n\u0E43\u0E1A\u0E2B\u0E19\u0E49\u0E32\u0E02\u0E2D\u0E07\u0E40\u0E18\u0E2D\u0E01\u0E25\u0E31\u0E1A\u0E14\u0E39\u0E42\u0E28\u0E01\u0E40\u0E28\u0E23\u0E49\u0E32"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E21\u0E31\u0E19\u0E44\u0E21\u0E48\u0E40\u0E02\u0E49\u0E32\u0E01\u0E31\u0E1A\u0E07\u0E32\u0E19\u0E23\u0E37\u0E48\u0E19\u0E40\u0E23\u0E34\u0E07\u0E19\u0E35\u0E49\u0E40\u0E25\u0E22"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E09\u0E31\u0E19\u0E44\u0E14\u0E49\u0E01\u0E30\u0E1E\u0E23\u0E34\u0E1A\u0E15\u0E32\u0E2D\u0E35\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07\n\u0E40\u0E18\u0E2D\u0E01\u0E47\u0E44\u0E14\u0E49\u0E2B\u0E32\u0E22\u0E44\u0E1B"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Narrator
    text: "\u0E42\u0E14\u0E22\u0E17\u0E34\u0E49\u0E07\u0E1A\u0E32\u0E07\u0E2A\u0E34\u0E48\u0E07\u0E40\u0E2D\u0E32\u0E44\u0E27\u0E49\u0E08\u0E32\u0E01\u0E1A\u0E19\u0E17\u0E49\u0E2D\u0E07\u0E1F\u0E49\u0E32\n\u0E1A\u0E31\u0E15\u0E23\u0E40\u0E0A\u0E34\u0E0D\u0E44\u0E14\u0E49\u0E15\u0E01\u0E25\u0E07\u0E21\u0E32\u0E1A\u0E19\u0E2B\u0E19\u0E49\u0E32\u0E1C\u0E32\u0E01\u0E02\u0E2D\u0E07\u0E0B\u0E2D\u0E21"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 0
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E19\u0E35\u0E48\u0E21\u0E31\u0E19! \u0E1A\u0E31\u0E15\u0E23\u0E40\u0E0A\u0E34\u0E0D\u0E19\u0E35\u0E48\u0E19\u0E32\n\u0E43\u0E19\u0E17\u0E35\u0E48\u0E2A\u0E38\u0E14\u0E01\u0E47\u0E44\u0E14\u0E49\u0E21\u0E32\u0E41\u0E25\u0E49\u0E27~\n\u0E41\u0E15\u0E48\u0E27\u0E48\u0E32..."
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "(\u0E40\u0E18\u0E2D\u0E04\u0E19\u0E19\u0E31\u0E49\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E04\u0E19\u0E43\u0E2B\u0E49\u0E1A\u0E31\u0E15\u0E23\u0E40\u0E0A\u0E34\u0E0D\u0E19\u0E35\u0E49\u0E2A\u0E34\u0E19\u0E30
      \u0E04\u0E07\u0E15\u0E49\u0E2D\u0E07\u0E44\u0E1B\u0E02\u0E2D\u0E1A\u0E04\u0E38\u0E13\u0E0B\u0E30\u0E41\u0E25\u0E49\u0E27)"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  - characterName: Zom
    text: "\u0E0B\u0E2D\u0E21\u0E40\u0E14\u0E34\u0E19\u0E01\u0E25\u0E31\u0E1A\u0E44\u0E1B\u0E2B\u0E22\u0E34\u0E1A\u0E40\u0E2A\u0E37\u0E49\u0E2D\u0E1C\u0E49\u0E32\u0E15\u0E31\u0E27\u0E40\u0E01\u0E48\u0E07
      \u0E01\u0E48\u0E2D\u0E19\u0E17\u0E35\u0E48\u0E08\u0E30\u0E40\u0E14\u0E34\u0E19\u0E44\u0E1B\u0E40\u0E02\u0E49\u0E32\u0E41\u0E16\u0E27\u0E40\u0E02\u0E49\u0E32\u0E2A\u0E39\u0E48\u0E40\u0E02\u0E32\u0E27\u0E07\u0E01\u0E15
      \u0E42\u0E14\u0E22\u0E22\u0E34\u0E49\u0E21\u0E41\u0E09\u0E48\u0E07\u0E15\u0E25\u0E2D\u0E14\u0E17\u0E32\u0E07"
    showPlayer: 1
    showCharacter: 1
    isPlayerSpeaking: 1
    characterPortrait: {fileID: 0}
  bossDialogues: []
